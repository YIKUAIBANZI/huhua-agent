# DashScope（阿里云百炼）OpenAI 兼容端点
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主对话流模型（qwen3.6-plus 对话最自然；qwen-plus / qwen-max 也行）
LLM_MODEL=qwen3.6-plus

# 结构化输出（Triage / editor / wrapper）专用——qwen3.6-plus 的 function-calling 太慢
# 留空则回退到 LLM_MODEL
LLM_STRUCTURED_MODEL=qwen-plus

LLM_TEMPERATURE=0.7

# RAG
CHROMA_DIR=./data/chroma_db
RAG_TOP_K=5
ENABLE_RAG=false

# SQLite
DATABASE_URL=sqlite:///./data/huhua.db
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite3
SESSION_RETENTION_DAYS=7
