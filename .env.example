# DashScope（阿里云百炼）OpenAI 兼容端点
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主对话流模型（qwen3.6-plus 对话最自然；qwen-plus / qwen-max 也行）
LLM_MODEL=qwen3.6-plus

# 结构化输出（Triage / editor / wrapper）专用——qwen3.6-plus 的 function-calling 太慢
# 留空则回退到 LLM_MODEL
LLM_STRUCTURED_MODEL=qwen-plus

# 图片文字识别；留空时根据 API 地址自动选择 DeepSeek Flash / Qwen VL / OpenAI 视觉模型
LLM_VISION_MODEL=

LLM_TEMPERATURE=0.7

# 可选：用户主动点击的 Jev 岗位匹配参考分；留空则隐藏入口
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=8

# RAG
CHROMA_DIR=./data/chroma_db
RAG_TOP_K=5
ENABLE_RAG=false

# 使用 DeepSeek 时，将上面的模型配置改为：
# LLM_PROVIDER=deepseek
# LLM_API_KEY=<在本地填写新生成的密钥，不要提交或贴到聊天里>
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_STRUCTURED_MODEL=deepseek-flash
# LLM_VISION_MODEL=deepseek-flash

# SQLite
DATABASE_URL=sqlite:///./data/huhua.db
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite3
SESSION_RETENTION_DAYS=7
