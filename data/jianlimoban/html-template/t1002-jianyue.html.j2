<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ basic_info.name }} · 个人简历</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 210mm; min-height: 297mm;
    padding: 16mm 16mm;
    font-family: 'PingFang SC', 'Noto Sans SC', -apple-system, sans-serif;
    color: #2b2b2b;
    background: #fff;
    font-size: 10pt;
    line-height: 1.7;
  }
  .header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 18px;
  }
  .title-block { display: flex; align-items: baseline; gap: 12px; }
  .title-block .cn-wrap {
    background: #b8d8d8;
    padding: 4px 28px 4px 18px;
    border-radius: 4px;
    transform: skewX(-8deg);
  }
  .title-block .cn-wrap span { transform: skewX(8deg); display: inline-block; font-size: 24pt; font-weight: 700; color: #fff; letter-spacing: 4px; }
  .title-block .en {
    font-size: 14pt; color: #4a8a8a; font-style: italic; letter-spacing: 1px;
    border-left: 2px solid #4a8a8a; padding-left: 12px;
  }
  .icons { display: flex; gap: 8px; }
  .icon-circle { width: 24px; height: 24px; border-radius: 50%; background: #b8d8d8; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 11pt; }
  .divider { height: 1px; background: linear-gradient(90deg, #b8d8d8 0%, transparent 100%); margin-bottom: 14px; }

  .section-title {
    background: #d4e8e8;
    color: #2d6a6a;
    padding: 4px 28px 4px 16px;
    font-size: 11pt; font-weight: 600;
    margin: 16px 0 10px;
    clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);
    width: fit-content;
    min-width: 110px;
    transform: skewX(-4deg);
  }
  .section-title span { display: inline-block; transform: skewX(4deg); }

  .info-row { display: flex; gap: 24px; align-items: flex-start; padding: 4px 8px; }
  .info-grid {
    flex: 1;
    display: grid; grid-template-columns: 1fr 1fr;
    column-gap: 32px; row-gap: 6px;
  }
  .info-item .label { color: #555; display: inline-block; min-width: 56px; }
  .info-item .label::after { content: '：'; }
  .photo {
    width: 95px; height: 120px;
    background: #d6dbdf;
    border-radius: 3px;
    display: flex; align-items: flex-end; justify-content: center;
    color: #fff; font-size: 8pt;
    flex: none;
    position: relative;
  }
  .photo::before {
    content: '照片'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    color: #aaa; font-size: 9pt;
  }
  .photo .badge { background: rgba(0,0,0,0.5); padding: 2px 6px; margin-bottom: 4px; border-radius: 2px; }

  .item { padding: 0 8px; margin-bottom: 10px; }
  .item-text { font-size: 10pt; color: #333; }
  ul { margin-left: 18px; }
  li { font-size: 9.5pt; margin-bottom: 3px; color: #333; }
  .desc { font-size: 9.5pt; color: #333; padding: 0 8px; }
</style>
</head>
<body>
  <div class="header">
    <div class="title-block">
      <div class="cn-wrap"><span>个人简历</span></div>
      <div class="en">Personal resume</div>
    </div>
    <div class="icons">
      <span class="icon-circle">✉</span>
      <span class="icon-circle">☎</span>
      <span class="icon-circle">i</span>
    </div>
  </div>
  <div class="divider"></div>

  <div class="section-title"><span>基本信息</span></div>
  <div class="info-row">
    <div class="info-grid">
      {% if basic_info.name %}<div class="info-item"><span class="label">姓　名</span>{{ basic_info.name }}</div>{% endif %}
      {% if basic_info.birthday %}<div class="info-item"><span class="label">出生年月</span>{{ basic_info.birthday }}</div>{% endif %}
      {% if basic_info.ethnicity %}<div class="info-item"><span class="label">民　族</span>{{ basic_info.ethnicity }}</div>{% endif %}
      {% if basic_info.height %}<div class="info-item"><span class="label">身　高</span>{{ basic_info.height }}</div>{% endif %}
      {% if basic_info.phone %}<div class="info-item"><span class="label">电　话</span>{{ basic_info.phone }}</div>{% endif %}
      {% if basic_info.political %}<div class="info-item"><span class="label">政治面貌</span>{{ basic_info.political }}</div>{% endif %}
      {% if basic_info.email %}<div class="info-item"><span class="label">邮　箱</span>{{ basic_info.email }}</div>{% endif %}
      {% if education and education[0].school %}<div class="info-item"><span class="label">毕业院校</span>{{ education[0].school }}</div>{% endif %}
      {% if basic_info.location %}<div class="info-item"><span class="label">住　址</span>{{ basic_info.location }}</div>{% endif %}
      {% if education and education[0].degree %}<div class="info-item"><span class="label">学　历</span>{{ education[0].degree }}</div>{% endif %}
    </div>
    {% if basic_info.photo %}<div class="photo" style="background:none;"><img src="{{ basic_info.photo|safe }}" style="position:relative;z-index:2;width:100%;height:100%;object-fit:cover;border-radius:4px;"></div>{% else %}<div class="photo"><div class="badge">点击更改/替换</div></div>{% endif %}
  </div>

  {% if education %}
  <div class="section-title"><span>教育背景</span></div>
  <div class="item">
    {% for edu in education %}
    <p class="item-text">{{ edu.start_date }}—{{ edu.end_date }}　就读于{{ edu.school }}{% if edu.major %}{{ edu.major }}专业{% endif %}{% if edu.degree %}（{{ edu.degree }}）{% endif %}。{% if edu.highlights %}{{ edu.highlights }}{% endif %}</p>
    {% endfor %}
  </div>
  {% endif %}

  {% if work_experience %}
  <div class="section-title"><span>实习经历</span></div>
  {% for job in work_experience %}
  <div class="item">
    <ul>
      <li>实习时间：{{ job.start_date }}—{{ job.end_date }}。</li>
      <li>单位：{{ job.company }}。</li>
      <li>职务：{{ job.title }}。</li>
      {% if job.bullets %}
      {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
      {% endif %}
    </ul>
  </div>
  {% endfor %}
  {% endif %}

  {% if projects %}
  <div class="section-title"><span>{{ experience_section_title or "项目经历" }}</span></div>
  {% for p in projects %}
  <div class="item">
    <p class="item-text">{{ p.name }}{% if p.role %}，{{ p.role }}{% endif %}，{{ p.start_date }}—{{ p.end_date }}</p>
    {% if p.polished_bullets %}
    <ul>{% for b in p.polished_bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% elif p.description %}<p class="item-text">{{ p.description }}</p>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if skill_groups %}
  <div class="section-title"><span>技能证书</span></div>
  <div class="item">
    {% for group_name, items in skill_groups.items() %}
    {% if items %}<div style="margin-bottom:4px;"><strong>{{ group_name }}：</strong>{{ items | join(' / ') }}</div>{% endif %}
    {% endfor %}
  </div>
  {% elif skills %}
  <div class="section-title"><span>技能证书</span></div>
  <div class="item">
    <ul>
      {% for s in skills %}<li>{{ s }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if self_evaluation %}
  <div class="section-title"><span>自我评价</span></div>
  <p class="desc">{{ self_evaluation }}</p>
  {% endif %}
</body>
</html>
