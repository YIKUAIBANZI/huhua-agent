<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ basic_info.name }} · 个人简历</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 210mm; min-height: 297mm;
    padding: 16mm 16mm;
    font-family: 'PingFang SC', 'Noto Sans SC', -apple-system, sans-serif;
    color: #2b2b2b;
    background: #fff;
    font-size: 10pt;
    line-height: 1.7;
  }
  .header {
    display: flex; justify-content: space-between; align-items: flex-start;
    border-bottom: 2px solid #7fb1c4;
    padding-bottom: 14px;
    margin-bottom: 14px;
  }
  .name-block .name {
    font-size: 30pt; font-weight: 700; color: #1a1a1a; letter-spacing: 4px;
    margin-bottom: 4px;
  }
  .name-block .meta {
    font-size: 9.5pt; color: #555; line-height: 1.8;
  }
  .name-block .meta span { margin-right: 14px; }
  .photo {
    width: 90px; height: 115px;
    background: #e8e8e8;
    border-radius: 3px;
    display: flex; align-items: flex-end; justify-content: center;
    color: #fff; font-size: 8pt;
    flex: none;
    position: relative;
  }
  .photo::before {
    content: '照片'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    color: #aaa; font-size: 9pt;
  }
  .photo .badge { background: rgba(0,0,0,0.5); padding: 2px 6px; margin-bottom: 4px; border-radius: 2px; }

  .section-title {
    background: linear-gradient(90deg, #b8d8d8 0%, #d8e8e8 100%);
    color: #2d5d6d;
    padding: 5px 22px 5px 14px;
    font-size: 11pt; font-weight: 600;
    margin: 14px 0 10px;
    clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);
    width: fit-content;
    min-width: 130px;
  }

  .item { padding: 0 8px; margin-bottom: 10px; }
  .item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .item-title { font-weight: 600; color: #1a1a1a; }
  .item-date { color: #5b8fb0; font-size: 9.5pt; }
  .item-sub { color: #555; font-size: 9.5pt; }
  ul { margin-left: 18px; }
  li { font-size: 9.5pt; margin-bottom: 3px; color: #333; }
  .desc { font-size: 9.5pt; color: #333; padding: 0 8px; }
</style>
</head>
<body>
  <div class="header">
    <div class="name-block">
      <div class="name">{{ basic_info.name }}</div>
      <div class="meta">
        {% if basic_info.objective %}<span>求职意向：{{ basic_info.objective }}</span>{% endif %}
        {% if basic_info.phone %}<span>电话：{{ basic_info.phone }}</span>{% endif %}
        {% if basic_info.email %}<span>邮箱：{{ basic_info.email }}</span>{% endif %}<br>
        {% if basic_info.hometown %}<span>所在地：{{ basic_info.hometown }}</span>{% endif %}
        {% if basic_info.political %}<span>政治面貌：{{ basic_info.political }}</span>{% endif %}
        <span>身　高：167cm</span>
      </div>
    </div>
    <div class="photo"><div class="badge">点击更改/替换</div></div>
  </div>

  {% if education %}
  <div class="section-title">教育背景</div>
  {% for edu in education %}
  <div class="item">
    <div class="item-header">
      <span class="item-title">{{ edu.school }}　{{ edu.major }}{% if edu.degree %}（{{ edu.degree }}）{% endif %}</span>
      <span class="item-date">{{ edu.start_date }}—{{ edu.end_date }}</span>
    </div>
    {% if edu.highlights %}<div class="item-sub">{{ edu.highlights }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if work_experience %}
  <div class="section-title">工作经历</div>
  {% for job in work_experience %}
  <div class="item">
    <div class="item-header">
      <span class="item-title">{{ job.company }}　{{ job.title }}</span>
      <span class="item-date">{{ job.start_date }}—{{ job.end_date }}</span>
    </div>
    {% if job.bullets %}
    <ul>
      {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if projects %}
  <div class="section-title">校园实践</div>
  {% for p in projects %}
  <div class="item">
    <div class="item-header">
      <span class="item-title">{{ p.name }}{% if p.role %}　{{ p.role }}{% endif %}</span>
      <span class="item-date">{{ p.start_date }}—{{ p.end_date }}</span>
    </div>
    {% if p.description %}<div class="item-sub">{{ p.description }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if skills %}
  <div class="section-title">技能证书</div>
  <div class="item">
    <ul>
      {% for s in skills %}<li>{{ s }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if self_evaluation %}
  <div class="section-title">自我评价</div>
  <p class="desc">{{ self_evaluation }}</p>
  {% endif %}
</body>
</html>
