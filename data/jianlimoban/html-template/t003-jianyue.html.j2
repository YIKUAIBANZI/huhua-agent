<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ basic_info.name }} · 个人简历</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 210mm; min-height: 297mm;
    font-family: 'PingFang SC', 'Noto Sans SC', -apple-system, sans-serif;
    color: #2b2b2b;
    background: #fff;
    font-size: 10pt;
    line-height: 1.65;
    display: flex;
    flex-direction: column;
  }
  .top-bar {
    background: #1a3a5c;
    height: 8px;
    width: 100%;
  }
  .layout {
    display: flex;
    flex: 1;
  }
  .sidebar {
    width: 30%;
    background: #1e4068;
    color: #d8e8f4;
    padding: 26px 20px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .photo {
    width: 100px; height: 126px;
    background: #163256;
    border: 2px solid #3a6a9c;
    border-radius: 4px;
    margin: 0 auto 14px;
    display: flex; align-items: center; justify-content: center;
    color: #6a9acc; font-size: 9pt;
  }
  .s-name {
    text-align: center;
    font-size: 18pt; font-weight: 600;
    color: #fff;
    letter-spacing: 4px;
    margin-bottom: 3px;
  }
  .s-target {
    text-align: center;
    font-size: 9pt;
    color: #8ab8d8;
    margin-bottom: 20px;
  }
  .s-section { margin-bottom: 18px; }
  .s-section-title {
    font-size: 10.5pt; font-weight: 600;
    color: #fff;
    background: #163256;
    padding: 4px 10px;
    border-radius: 2px;
    margin-bottom: 10px;
    letter-spacing: 1px;
  }
  .s-info-row {
    display: flex; align-items: flex-start; gap: 6px;
    font-size: 9pt;
    margin-bottom: 6px;
    color: #c0d8ec;
  }
  .s-info-row .lbl {
    color: #8ab8d8;
    min-width: 44px;
    flex: none;
  }
  .s-info-row .lbl::after { content: '：'; }
  .s-edu-row { margin-bottom: 10px; }
  .s-edu-school {
    font-weight: 600;
    font-size: 9.5pt;
    color: #fff;
    margin-bottom: 2px;
  }
  .s-edu-detail {
    font-size: 9pt; color: #a0c4e0;
  }
  .s-skill-row { margin-bottom: 8px; }
  .s-skill-name-row {
    display: flex; justify-content: space-between;
    font-size: 9pt; margin-bottom: 3px;
    color: #c0d8ec;
  }
  .s-skill-bar {
    height: 4px;
    background: #163256;
    border-radius: 2px;
    overflow: hidden;
  }
  .s-skill-fill {
    height: 100%;
    background: #4a9ad4;
  }

  .main {
    flex: 1;
    padding: 26px 24px;
    background: #fff;
  }
  .m-section { margin-bottom: 16px; }
  .m-section-title {
    display: flex; align-items: center; gap: 8px;
    font-size: 11.5pt; font-weight: 600;
    color: #1a3a5c;
    background: #e8f0f8;
    padding: 5px 12px;
    border-left: 4px solid #1e4068;
    margin-bottom: 10px;
  }
  .item { margin-bottom: 10px; }
  .item-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 3px;
  }
  .item-title { font-weight: 600; font-size: 10pt; color: #1a2a3a; }
  .item-date { font-size: 9pt; color: #6a8aaa; }
  .item-sub { font-size: 9pt; color: #3a6a9c; margin-bottom: 3px; }
  ul { margin-left: 17px; }
  li { font-size: 9.5pt; color: #333; margin-bottom: 3px; }
  .desc { font-size: 9.5pt; color: #333; }
  .skill-text-row { font-size: 9.5pt; color: #333; margin-bottom: 3px; }
</style>
</head>
<body>
  <div class="top-bar"></div>
  <div class="layout">
    <aside class="sidebar">
      <div class="photo">照片</div>
      <div class="s-name">{{ basic_info.name }}</div>
      {% if basic_info.objective %}<div class="s-target">求职意向：{{ basic_info.objective }}</div>{% endif %}

      <div class="s-section">
        <div class="s-section-title">基本信息</div>
        {% if basic_info.birthday %}<div class="s-info-row"><span class="lbl">出生年月</span>{{ basic_info.birthday }}</div>{% endif %}
        {% if basic_info.ethnicity %}<div class="s-info-row"><span class="lbl">民　族</span>{{ basic_info.ethnicity }}{% if basic_info.political %} · {{ basic_info.political }}{% endif %}</div>{% endif %}
        {% if basic_info.phone %}<div class="s-info-row"><span class="lbl">电　话</span>{{ basic_info.phone }}</div>{% endif %}
        {% if basic_info.email %}<div class="s-info-row"><span class="lbl">邮　箱</span>{{ basic_info.email }}</div>{% endif %}
        {% if education and education[0].school %}<div class="s-info-row"><span class="lbl">毕业院校</span>{{ education[0].school }}</div>{% endif %}
        {% if education and education[0].degree %}<div class="s-info-row"><span class="lbl">学　历</span>{{ education[0].degree }}</div>{% endif %}
      </div>

      {% if education %}
      <div class="s-section">
        <div class="s-section-title">教育背景</div>
        {% for edu in education %}
        <div class="s-edu-row">
          <div class="s-edu-school">{{ edu.school }}</div>
          <div class="s-edu-detail">{{ edu.major }}{% if edu.degree %}（{{ edu.degree }}）{% endif %}</div>
          <div class="s-edu-detail">{{ edu.start_date }} — {{ edu.end_date }}</div>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      <div class="s-section">
        <div class="s-section-title">技能证书</div>
        <div class="s-skill-row">
          <div class="s-skill-name-row"><span>Office 全家桶</span><span>90%</span></div>
          <div class="s-skill-bar"><div class="s-skill-fill" style="width:90%"></div></div>
        </div>
        <div class="s-skill-row">
          <div class="s-skill-name-row"><span>英语（CET-6）</span><span>85%</span></div>
          <div class="s-skill-bar"><div class="s-skill-fill" style="width:85%"></div></div>
        </div>
        <div class="s-skill-row">
          <div class="s-skill-name-row"><span>数据分析</span><span>75%</span></div>
          <div class="s-skill-bar"><div class="s-skill-fill" style="width:75%"></div></div>
        </div>
        <div class="s-skill-row">
          <div class="s-skill-name-row"><span>团队协作</span><span>95%</span></div>
          <div class="s-skill-bar"><div class="s-skill-fill" style="width:95%"></div></div>
        </div>
      </div>
    </aside>

    <main class="main">
      {% if education %}
      <div class="m-section">
        <div class="m-section-title">教育背景</div>
        {% for edu in education %}
        <div class="item">
          <div class="item-header">
            <span class="item-title">{{ edu.school }}　{{ edu.major }}{% if edu.degree %}（{{ edu.degree }}）{% endif %}</span>
            <span class="item-date">{{ edu.start_date }} — {{ edu.end_date }}</span>
          </div>
          {% if edu.highlights %}
          <div class="item-sub">主修课程</div>
          <ul>
            <li>{{ edu.highlights }}</li>
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if work_experience %}
      <div class="m-section">
        <div class="m-section-title">实习经历</div>
        {% for job in work_experience %}
        <div class="item">
          <div class="item-header">
            <span class="item-title">{{ job.company }}</span>
            <span class="item-date">{{ job.start_date }} — {{ job.end_date }}</span>
          </div>
          {% if job.title %}<div class="item-sub">{{ job.title }}</div>{% endif %}
          {% if job.bullets %}
          <ul>
            {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if projects %}
      <div class="m-section">
        <div class="m-section-title">校园经历</div>
        {% for p in projects %}
        <div class="item">
          <div class="item-header">
            <span class="item-title">{{ p.name }}{% if p.role %}　{{ p.role }}{% endif %}</span>
            <span class="item-date">{{ p.start_date }} — {{ p.end_date }}</span>
          </div>
          {% if p.description %}
          <ul>
            <li>{{ p.description }}</li>
          </ul>
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if skills %}
      <div class="m-section">
        <div class="m-section-title">技能证书</div>
        {% for s in skills %}<div class="skill-text-row">{{ s }}</div>{% endfor %}
      </div>
      {% endif %}

      {% if self_evaluation %}
      <div class="m-section">
        <div class="m-section-title">自我评价</div>
        <p class="desc">{{ self_evaluation }}</p>
      </div>
      {% endif %}
    </main>
  </div>
</body>
</html>
