<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ basic_info.name }} · 个人简历</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 210mm; min-height: 297mm;
    padding: 18mm 16mm;
    font-family: 'PingFang SC', 'Noto Sans SC', -apple-system, sans-serif;
    color: #2b2b2b;
    background: #fff;
    font-size: 10.5pt;
    line-height: 1.7;
  }
  .header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 18px;
  }
  .title-block .cn-title {
    font-size: 32pt; font-weight: 300; letter-spacing: 4px; color: #1a1a1a;
  }
  .title-block .en-title {
    font-size: 11pt; color: #888; letter-spacing: 2px; margin-top: -4px;
  }
  .photo {
    width: 95px; height: 120px;
    background: #e8e8e8;
    border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    color: #aaa; font-size: 9pt;
  }
  .section-title {
    background: #ededed;
    padding: 6px 14px;
    font-size: 11.5pt; font-weight: 600;
    color: #1a1a1a;
    border-radius: 3px;
    margin: 18px 0 10px;
  }
  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 32px;
    row-gap: 6px;
    padding: 4px 14px;
  }
  .info-item { font-size: 10pt; }
  .info-item .label { color: #555; display: inline-block; min-width: 56px; }
  .info-item .label::after { content: '：'; }

  .item { padding: 0 14px; margin-bottom: 14px; }
  .item-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 4px;
  }
  .item-title { font-weight: 600; font-size: 10.5pt; color: #1a1a1a; }
  .item-date { color: #777; font-size: 9.5pt; }
  .item-sub { color: #555; font-size: 9.5pt; margin-bottom: 4px; }
  ul { margin-left: 18px; }
  li { margin-bottom: 3px; font-size: 10pt; color: #333; }
  .desc { font-size: 10pt; color: #333; padding: 0 14px; }
</style>
</head>
<body>
  <div class="header">
    <div class="title-block">
      <div class="cn-title">个人简历</div>
      <div class="en-title">— 一个人 一份计划 — Personal resume</div>
    </div>
    {% if basic_info.photo %}<div class="photo"><img src="{{ basic_info.photo }}" style="width:100%;height:100%;object-fit:cover;border-radius:4px;"></div>{% else %}<div class="photo">照片</div>{% endif %}
  </div>

  <div class="section-title">基本信息</div>
  <div class="info-grid">
    {% if basic_info.name %}<div class="info-item"><span class="label">姓　名</span>{{ basic_info.name }}</div>{% endif %}
    {% if basic_info.birthday %}<div class="info-item"><span class="label">出生年月</span>{{ basic_info.birthday }}</div>{% endif %}
    {% if basic_info.ethnicity %}<div class="info-item"><span class="label">民　族</span>{{ basic_info.ethnicity }}</div>{% endif %}
    {% if basic_info.hometown %}<div class="info-item"><span class="label">籍　贯</span>{{ basic_info.hometown }}</div>{% endif %}
    {% if basic_info.phone %}<div class="info-item"><span class="label">电　话</span>{{ basic_info.phone }}</div>{% endif %}
    {% if education and education[0].school %}<div class="info-item"><span class="label">毕业院校</span>{{ education[0].school }}</div>{% endif %}
    {% if basic_info.email %}<div class="info-item"><span class="label">邮　箱</span>{{ basic_info.email }}</div>{% endif %}
    {% if education and education[0].degree %}<div class="info-item"><span class="label">学　历</span>{{ education[0].degree }}</div>{% endif %}
  </div>

  {% if education %}
  <div class="section-title">教育背景</div>
  {% for edu in education %}
  <div class="item">
    <div class="item-header">
      <span class="item-title">{{ edu.school }}　{{ edu.major }}{% if edu.degree %}（{{ edu.degree }}）{% endif %}</span>
      <span class="item-date">{{ edu.start_date }}—{{ edu.end_date }}</span>
    </div>
    {% if edu.highlights %}<div class="item-sub">{{ edu.highlights }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if work_experience %}
  <div class="section-title">实习经历</div>
  {% for job in work_experience %}
  <div class="item">
    <div class="item-header">
      <span class="item-title">{{ job.company }}　{{ job.title }}</span>
      <span class="item-date">{{ job.start_date }}—{{ job.end_date }}</span>
    </div>
    {% if job.bullets %}
    <ul>
      {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if projects %}
  <div class="section-title">{{ experience_section_title or "项目经历" }}</div>
  {% for p in projects %}
  <div class="item">
    <div class="item-header">
      <span class="item-title">{{ p.name }}{% if p.role %}　{{ p.role }}{% endif %}</span>
      <span class="item-date">{{ p.start_date }}—{{ p.end_date }}</span>
    </div>
    {% if p.polished_bullets %}
    <ul>{% for b in p.polished_bullets %}<li>{{ b }}</li>{% endfor %}</ul>
    {% elif p.description %}<div class="item-sub">{{ p.description }}</div>{% endif %}
  </div>
  {% endfor %}
  {% endif %}

  {% if skill_groups %}
  <div class="section-title">技能证书</div>
  <div class="item">
    {% for group_name, items in skill_groups.items() %}
    {% if items %}<div style="margin-bottom:4px;"><strong>{{ group_name }}：</strong>{{ items | join(' / ') }}</div>{% endif %}
    {% endfor %}
  </div>
  {% elif skills %}
  <div class="section-title">技能证书</div>
  <div class="item">
    <ul>
      {% for s in skills %}<li>{{ s }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  {% if self_evaluation %}
  <div class="section-title">自我评价</div>
  <p class="desc">{{ self_evaluation }}</p>
  {% endif %}
</body>
</html>
