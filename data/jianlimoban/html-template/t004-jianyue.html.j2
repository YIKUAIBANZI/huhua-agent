<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ basic_info.name }} · 个人简历</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 210mm; min-height: 297mm;
    font-family: 'PingFang SC', 'Noto Sans SC', -apple-system, sans-serif;
    color: #2b2b2b;
    background: #fff;
    font-size: 10pt;
    line-height: 1.65;
    display: flex;
    flex-direction: column;
  }
  .top-bar {
    background: #3a3a3a;
    height: 10px;
  }
  .page-content {
    flex: 1;
    padding: 20px 28px 20px;
  }
  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e0e0e0;
  }
  .header-left { flex: 1; }
  .header-title {
    font-size: 22pt; font-weight: 300;
    color: #1a1a1a;
    letter-spacing: 6px;
    margin-bottom: 10px;
  }
  .header-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 28px;
    row-gap: 5px;
  }
  .h-info-row {
    display: flex; align-items: center; gap: 6px;
    font-size: 9.5pt; color: #444;
  }
  .h-info-row .lbl {
    color: #666;
    min-width: 52px;
    display: inline-block;
  }
  .h-info-row .lbl::after { content: '：'; }
  .photo {
    width: 90px; height: 114px;
    background: #e0e0e0;
    border-radius: 3px;
    display: flex; align-items: center; justify-content: center;
    color: #999; font-size: 9pt;
    flex: none;
    margin-left: 20px;
  }
  .section { margin-bottom: 14px; }
  .section-title {
    display: flex; align-items: center; gap: 10px;
    font-size: 11pt; font-weight: 600;
    color: #1a1a1a;
    padding: 4px 0 4px 12px;
    border-left: 4px solid #3a6aaa;
    margin-bottom: 8px;
  }
  .item { margin-bottom: 10px; padding-left: 4px; }
  .item-header {
    display: flex; justify-content: space-between; align-items: baseline;
    margin-bottom: 3px;
  }
  .item-title { font-weight: 600; font-size: 10pt; color: #1a1a1a; }
  .item-date { font-size: 9pt; color: #6a8aaa; }
  .item-sub { font-size: 9pt; color: #3a6aaa; margin-bottom: 3px; }
  ul { margin-left: 18px; }
  li { font-size: 9.5pt; color: #333; margin-bottom: 3px; }
  .skill-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 28px;
    row-gap: 4px;
    padding-left: 4px;
  }
  .skill-item { font-size: 9.5pt; color: #333; }
  .skill-item .lbl { color: #555; min-width: 52px; display: inline-block; }
  .skill-item .lbl::after { content: '：'; }
  .desc { font-size: 9.5pt; color: #333; padding-left: 4px; }
  .bottom-bar {
    background: #3a3a3a;
    height: 10px;
    margin-top: auto;
  }
</style>
</head>
<body>
  <div class="top-bar"></div>
  <div class="page-content">
    <div class="header">
      <div class="header-left">
        <div class="header-title">个人简历</div>
        <div class="header-info-grid">
          {% if basic_info.name %}<div class="h-info-row"><span class="lbl">姓　名</span>{{ basic_info.name }}</div>{% endif %}
          {% if basic_info.birthday %}<div class="h-info-row"><span class="lbl">出生年月</span>{{ basic_info.birthday }}</div>{% endif %}
          {% if basic_info.phone %}<div class="h-info-row"><span class="lbl">电　话</span>{{ basic_info.phone }}</div>{% endif %}
          {% if basic_info.ethnicity %}<div class="h-info-row"><span class="lbl">民　族</span>{{ basic_info.ethnicity }}</div>{% endif %}
          {% if basic_info.email %}<div class="h-info-row"><span class="lbl">邮　箱</span>{{ basic_info.email }}</div>{% endif %}
          {% if basic_info.political %}<div class="h-info-row"><span class="lbl">政治面貌</span>{{ basic_info.political }}</div>{% endif %}
          {% if basic_info.location %}<div class="h-info-row"><span class="lbl">地　址</span>{{ basic_info.location }}</div>{% endif %}
          {% if education and education[0].degree %}<div class="h-info-row"><span class="lbl">学　历</span>{{ education[0].degree }}</div>{% endif %}
        </div>
      </div>
      {% if basic_info.photo %}<div class="photo"><img src="{{ basic_info.photo }}" style="width:100%;height:100%;object-fit:cover;border-radius:4px;"></div>{% else %}<div class="photo">照片</div>{% endif %}
    </div>

    {% if education %}
    <div class="section">
      <div class="section-title">教育背景</div>
      {% for edu in education %}
      <div class="item">
        <div class="item-header">
          <span class="item-title">{{ edu.school }}</span>
          <span class="item-date">{{ edu.start_date }} — {{ edu.end_date }}</span>
        </div>
        {% if edu.major %}<div class="item-sub">{{ edu.major }}{% if edu.degree %}（{{ edu.degree }}）{% endif %}</div>{% endif %}
        {% if edu.highlights %}
        <ul>
          <li>{{ edu.highlights }}</li>
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if projects %}
    <div class="section">
      <div class="section-title">{{ experience_section_title or "项目经历" }}</div>
      {% for p in projects %}
      <div class="item">
        <div class="item-header">
          <span class="item-title">{{ p.start_date }} — {{ p.end_date }}　{{ p.name }}</span>
          {% if p.role %}<span class="item-date">{{ p.role }}</span>{% endif %}
        </div>
        {% if p.polished_bullets %}
        <ul>{% for b in p.polished_bullets %}<li>{{ b }}</li>{% endfor %}</ul>
        {% elif p.description %}
        <ul><li>{{ p.description }}</li></ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if work_experience %}
    <div class="section">
      <div class="section-title">实习经历</div>
      {% for job in work_experience %}
      <div class="item">
        <div class="item-header">
          <span class="item-title">{{ job.start_date }} — {{ job.end_date }}　{{ job.company }}</span>
          {% if job.title %}<span class="item-date">{{ job.title }}</span>{% endif %}
        </div>
        {% if job.bullets %}
        <ul>
          {% for b in job.bullets %}<li>{{ b }}</li>{% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}

    {% if skill_groups %}
    <div class="section">
      <div class="section-title">技能证书</div>
      <div>
        {% for group_name, items in skill_groups.items() %}
        {% if items %}<div style="margin-bottom:4px;"><strong>{{ group_name }}：</strong>{{ items | join(' / ') }}</div>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% elif skills %}
    <div class="section">
      <div class="section-title">技能证书</div>
      <div class="skill-grid">
        {% for s in skills %}<div class="skill-item">{{ s }}</div>{% endfor %}
      </div>
    </div>
    {% endif %}

    {% if self_evaluation %}
    <div class="section">
      <div class="section-title">自我评价</div>
      <p class="desc">{{ self_evaluation }}</p>
    </div>
    {% endif %}
  </div>
  <div class="bottom-bar"></div>
</body>
</html>
