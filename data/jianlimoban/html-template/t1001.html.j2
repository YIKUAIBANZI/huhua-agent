<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ basic_info.name }} · 个人简历</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 210mm; min-height: 297mm;
    padding: 14mm 16mm;
    font-family: 'PingFang SC', 'Noto Sans SC', -apple-system, sans-serif;
    color: #2b2b2b;
    background: #fff;
    font-size: 10pt;
    line-height: 1.65;
  }
  .header {
    display: flex; justify-content: space-between; align-items: flex-end;
    margin-bottom: 14px;
  }
  .title-block .cn { font-size: 28pt; font-weight: 700; color: #1a1a1a; letter-spacing: 4px; }
  .icons { display: flex; gap: 6px; }
  .icon-circle { width: 22px; height: 22px; border-radius: 50%; background: #6791ad; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 10pt; }

  .section-title {
    background: #cfdde7;
    color: #2d4d63;
    padding: 5px 22px 5px 14px;
    font-size: 11pt; font-weight: 600;
    margin: 14px 0 10px;
    clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);
    width: fit-content;
    min-width: 130px;
  }

  .info-row { display: flex; gap: 24px; align-items: flex-start; padding: 4px 8px; }
  .info-grid {
    flex: 1;
    display: grid; grid-template-columns: 1fr 1fr;
    column-gap: 32px; row-gap: 6px;
  }
  .info-item .label { color: #555; display: inline-block; min-width: 56px; }
  .info-item .label::after { content: '：'; }
  .photo {
    width: 90px; height: 115px;
    background: #e8e8e8;
    border-radius: 3px;
    display: flex; align-items: center; justify-content: center;
    color: #aaa; font-size: 9pt;
    flex: none;
  }

  .item { padding: 0 8px; margin-bottom: 12px; }
  .item-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
  .item-title { font-weight: 600; color: #1a1a1a; }
  .item-date { color: #6791ad; font-size: 9.5pt; }
  .item-sub { color: #555; font-size: 9.5pt; }
  ul { margin-left: 18px; }
  li { font-size: 9.5pt; margin-bottom: 3px; color: #333; }
  .desc { font-size: 9.5pt; color: #333; padding: 0 8px; }
</style>
</head>
<body>
  <div class="header">
    <div class="title-block">
      <div class="cn">个人简历</div>
    </div>
    <div class="icons">
      <span class="icon-circle">✉</span>
      <span class="icon-circle">☎</span>
      <span class="icon-circle">i</span>
    </div>
  </div>

  <div class="section-title">基本信息</div>
  <div class="info-row">
    <div class="info-grid">
      {% if basic_info.name %}<div class="info-item"><span class="label">姓　名</span><span data-field-path="/basic_info/name">{{ basic_info.name }}</span></div>{% endif %}
      {% if basic_info.birthday %}<div class="info-item"><span class="label">出生年月</span><span data-field-path="/basic_info/birthday">{{ basic_info.birthday }}</span></div>{% endif %}
      {% if basic_info.ethnicity %}<div class="info-item"><span class="label">民　族</span><span data-field-path="/basic_info/ethnicity">{{ basic_info.ethnicity }}</span></div>{% endif %}
      {% if basic_info.height %}<div class="info-item"><span class="label">身　高</span><span data-field-path="/basic_info/height">{{ basic_info.height }}</span></div>{% endif %}
      {% if basic_info.phone %}<div class="info-item"><span class="label">电　话</span><span data-field-path="/basic_info/phone">{{ basic_info.phone }}</span></div>{% endif %}
      {% if has_education_section and education and education[0].school %}<div class="info-item"><span class="label">毕业院校</span><span data-field-path="/education/0/school">{{ education[0].school }}</span></div>{% endif %}
      {% if basic_info.email %}<div class="info-item"><span class="label">邮　箱</span><span data-field-path="/basic_info/email">{{ basic_info.email }}</span></div>{% endif %}
      {% if has_education_section and education and education[0].degree %}<div class="info-item"><span class="label">学　历</span><span data-field-path="/education/0/degree">{{ education[0].degree }}</span></div>{% endif %}
    </div>
    {% if basic_info.photo %}<div class="photo"><img src="{{ basic_info.photo }}" style="width:100%;height:100%;object-fit:cover;border-radius:4px;"></div>{% else %}<div class="photo">照片</div>{% endif %}
  </div>

  {% for section in resume_sections %}
{% if (section.kind == 'custom' and (section.title or section.content)) or (section.kind == 'education' and education) or (section.kind == 'work_experience' and work_experience) or (section.kind == 'projects' and projects) or (section.kind == 'skills' and (has_grouped_skills or skills)) or (section.kind == 'certificates' and certificates) or (section.kind == 'self_evaluation' and self_evaluation) %}
  {% if section.title %}
  <div class="section-title"><span{% if section.title_path %} data-field-path="{{ section.title_path }}"{% endif %}>{{ section.title }}</span></div>
  {% endif %}
  {% if section.kind == 'education' %}
  {% for edu in education %}{% set edu_index = loop.index0 %}
  <div class="item">
    <div class="item-header">
      <span class="item-title"><span data-field-path="/education/{{ edu_index }}/school">{{ edu.school }}</span>　<span data-field-path="/education/{{ edu_index }}/major">{{ edu.major }}</span>{% if edu.degree %}（<span data-field-path="/education/{{ edu_index }}/degree">{{ edu.degree }}</span>）{% endif %}</span>
      <span class="item-date"><span data-field-path="/education/{{ edu_index }}/start_date">{{ edu.start_date }}</span>—<span data-field-path="/education/{{ edu_index }}/end_date">{{ edu.end_date }}</span></span>
    </div>
    {% if edu.highlights %}<div class="item-sub"><span data-field-path="/education/{{ edu_index }}/highlights">{{ edu.highlights }}</span></div>{% endif %}
  </div>
  {% endfor %}

  {% elif section.kind == 'work_experience' %}
  {% for job in work_experience %}{% set job_index = loop.index0 %}
  <div class="item">
    <div class="item-header">
      <span class="item-title"><span data-field-path="/work_experience/{{ job_index }}/company">{{ job.company }}</span>　<span data-field-path="/work_experience/{{ job_index }}/title">{{ job.title }}</span></span>
      <span class="item-date"><span data-field-path="/work_experience/{{ job_index }}/start_date">{{ job.start_date }}</span>—<span data-field-path="/work_experience/{{ job_index }}/end_date">{{ job.end_date }}</span></span>
    </div>
    {% if job.bullets %}
    <ul>
      {% for b in job.bullets %}<li><span data-field-path="/work_experience/{{ job_index }}/bullets/{{ loop.index0 }}">{{ b }}</span></li>{% endfor %}
    </ul>
    {% endif %}
  </div>
  {% endfor %}

  {% elif section.kind == 'projects' %}
  {% for p in projects %}{% set p_index = loop.index0 %}
  <div class="item">
    <div class="item-header">
      <span class="item-title"><span data-field-path="/projects/{{ p_index }}/name">{{ p.name }}</span>{% if p.role %}　<span data-field-path="/projects/{{ p_index }}/role">{{ p.role }}</span>{% endif %}</span>
      <span class="item-date"><span data-field-path="/projects/{{ p_index }}/start_date">{{ p.start_date }}</span>—<span data-field-path="/projects/{{ p_index }}/end_date">{{ p.end_date }}</span></span>
    </div>
    {% if p.polished_bullets %}
    <ul>{% for b in p.polished_bullets %}<li><span data-field-path="/projects/{{ p_index }}/polished_bullets/{{ loop.index0 }}">{{ b }}</span></li>{% endfor %}</ul>
    {% elif p.description %}<div class="item-sub"><span data-field-path="/projects/{{ p_index }}/description">{{ p.description }}</span></div>{% endif %}
  </div>
  {% endfor %}

  {% elif section.kind == 'skills' %}
{% if has_grouped_skills %}
  <div class="item">
    {% for group_name, items in skill_groups.items() %}
    {% if items %}<div style="margin-bottom:4px;"><strong><span data-field-path="/skill_groups/{{ group_name | pointer_escape }}" data-field-kind="group-name">{{ group_name }}</span>：</strong>{% for skill in items %}<span data-field-path="/skill_groups/{{ group_name | pointer_escape }}/{{ loop.index0 }}">{{ skill }}</span>{% if not loop.last %} / {% endif %}{% endfor %}</div>{% endif %}
    {% endfor %}
  </div>
  {% elif skills %}
  <div class="item">
    <ul>
      {% for s in skills %}<li><span data-field-path="/skills/{{ loop.index0 }}">{{ s }}</span></li>{% endfor %}
    </ul>
  </div>
  {% endif %}
  {% elif section.kind == 'certificates' %}
  <div class="item"><ul>{% for certificate in certificates %}<li><span data-field-path="/certificates/{{ loop.index0 }}">{{ certificate }}</span></li>{% endfor %}</ul></div>
  {% elif section.kind == 'self_evaluation' %}
  <p class="desc"><span data-field-path="/self_evaluation">{{ self_evaluation }}</span></p>

  {% elif section.kind == 'custom' %}
  {% if section.content %}
  <p class="desc" style="white-space:pre-line;"><span{% if section.content_path %} data-field-path="{{ section.content_path }}"{% endif %}>{{ section.content }}</span></p>
  {% endif %}
  {% endif %}
{% endif %}
{% endfor %}
</body>
</html>
